# 本地服务默认只监听当前电脑。
HOST=127.0.0.1

# 需要手机在同一 Wi-Fi 访问时可改为 0.0.0.0。
# 付费图片生成仍只允许本机；仅在可信网络中按需设为 1。
ALLOW_LAN_IMAGE_API=0

# 图片生成服务（仅由 local-server.js 读取，浏览器不会看到密钥）
# 从 BytePlus ModelArk 控制台创建长期 API Key。
IMAGE_API_KEY=

# 在 ModelArk 控制台激活 Seedream 后填写实际模型 ID。
# 例如文档中的：dola-seedream-5-0-pro-260628
IMAGE_MODEL=

# 亚太区域默认值；欧洲区域可改为：
# https://ark.eu-west.bytepluses.com/api/v3
IMAGE_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# 单张图卡生成超时（毫秒）
IMAGE_API_TIMEOUT_MS=180000
